# Live — public HTTPS API (no trailing slash)
EXPO_PUBLIC_API_URL=https://YOUR-LIVE-API-HOST

# Local development (paused)
# Phone on same Wi‑Fi as API host:
# EXPO_PUBLIC_API_URL=http://192.168.1.9:8787
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:8787
